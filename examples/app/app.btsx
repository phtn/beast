import Card from "../card/card.btsx";
import Status from "../status/status.btsx";
props { title, themeClass, user, unreadCount, messages, groups }: { title: string; themeClass: string; user: { name: string; id: string; isAdmin: boolean }; unreadCount: number; messages: { id: string; text: string }[]; groups: { id: string; title: string; status: string; items: { label: string; value: string }[] }[] }

main#app.shell(class={themeClass})
  header.hero
    p.eyebrow Beast composition example
    h1 #{title}
  Card(user={user} unreadCount={unreadCount} messages={messages})
  Status(groups={groups})
