{
  "name": "beast-language-server",
  "version": "0.1.0",
  "description": "Language Server Protocol support for Beast BTSX components.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/language-service.d.ts",
  "exports": {
    ".": {
      "types": "./dist/language-service.d.ts",
      "default": "./dist/language-service.js"
    }
  },
  "bin": {
    "beast-language-server": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepack": "bun run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "beast",
    "btsx",
    "language-server",
    "lsp"
  ],
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "beast-tsrx": "0.2.6",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
