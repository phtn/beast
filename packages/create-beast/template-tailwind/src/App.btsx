import Header from './Header.btsx'
import type {Props} from './types'

props { source, direction, output, links }: Props
main.app
  Header(source={source} direction={direction} output={output})
  div(className='flex flex-col items-center justify-center mt-10')
    p Start building in
      span.arrow →
      code src/App.btsx.
    div.flex
      each link in links key link.id
        a.button(id={link.id} className='w-36 text-center flex justify-center' href={link.url} target="_blank" rel="noreferrer") #{link.label}

